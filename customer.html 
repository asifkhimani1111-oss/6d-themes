<!DOCTYPE html>
<html lang="gu">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#075c9a">
<title>K.H FRUITS - ગ્રાહક ખાતું</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f1f5f9;color:#183044}
header{background:#075c9a;color:white;padding:18px;text-align:center}
header h2{margin:0 0 5px}
main{max-width:750px;margin:auto;padding:14px}
.card{background:white;padding:15px;border-radius:13px;margin-bottom:13px;box-shadow:0 2px 9px #00000012}
h3{margin:0 0 12px;color:#075c9a}
input,button{font:inherit;padding:11px;border-radius:8px}
input{width:100%;border:1px solid #ccd8e2;margin:5px 0 10px}
button{border:0;background:#075c9a;color:white;cursor:pointer;margin:3px}
button.red{background:#c62828}
button.gray{background:#607d8b}
button.orange{background:#ef8c00}
.person{border:1px solid #dce7ef;border-radius:10px;padding:12px;margin:9px 0}
.person h3{margin:0 0 8px}
.crate{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;border-top:1px solid #eee;padding:10px 0}
.crate strong{flex:1;min-width:100px}
.qty{font-size:19px;font-weight:bold;color:#075c9a}
.small{font-size:12px;color:#64748b}
.actions{display:flex;gap:5px;flex-wrap:wrap}
</style>
</head>
<body>

<header>
<h2>K.H FRUITS</h2>
<div>ગ્રાહક ક્રેટ ખાતાવહી</div>
</header>

<main>

<section class="card">
<h3>નવો ગ્રાહક ઉમેરો</h3>
<input id="customerName" placeholder="ગ્રાહકનું નામ">
<button onclick="addCustomer()">+ ગ્રાહક ઉમેરો</button>
</section>

<section class="card">
<h3>ગ્રાહકોની યાદી</h3>
<div id="customerList"></div>
</section>

<section class="card">
<h3>બેકઅપ અને રિસ્ટોર</h3>
<button onclick="backup()">બેકઅપ ડાઉનલોડ</button>
<input type="file" id="restoreFile" accept=".json">
<button class="gray" onclick="restore()">બેકઅપ રિસ્ટોર</button>
<p class="small">ગ્રાહકનો ડેટા આ મોબાઇલના બ્રાઉઝરમાં જ અલગથી સંગ્રહિત થાય છે.</p>
</section>

<section class="card">
<h3>ગ્રાહકનો હિસાબ</h3>
<div id="ledger"></div>
</section>

</main>

<script>
const STORE_KEY="kh_fruits_customer_local_v1";

function emptyData(){
 return {customers:[],transactions:[]};
}

function loadData(){
 try{
  const raw=localStorage.getItem(STORE_KEY);
  if(!raw)return emptyData();
  const d=JSON.parse(raw);
  if(!Array.isArray(d.customers)||!Array.isArray(d.transactions))
   return emptyData();
  return d;
 }catch(e){
  alert("ડેટા વાંચવામાં મુશ્કેલી છે. બેકઅપ તપાસો.");
  return emptyData();
 }
}

let data=loadData();
let selectedCustomer=null;

function save(){
 localStorage.setItem(STORE_KEY,JSON.stringify(data));
 render();
}

function id(){
 return Date.now().toString(36)+Math.random().toString(36).slice(2,7);
}

function addCustomer(){
 const name=document.getElementById("customerName").value.trim();
 if(!name)return alert("ગ્રાહકનું નામ લખો.");
 data.customers.push({
  id:id(),
  name:name,
  crateTypes:[],
  archived:false
 });
 document.getElementById("customerName").value="";
 save();
}

function addCrate(customerId){
 const name=prompt("ક્રેટનું નામ લખો:");
 if(!name||!name.trim())return;
 const c=data.customers.find(x=>x.id===customerId);
 if(!c)return;
 c.crateTypes=c.crateTypes||[];
 if(c.crateTypes.some(x=>x.toLowerCase()===name.trim().toLowerCase()))
  return alert("આ ક્રેટનું નામ પહેલેથી છે.");
 c.crateTypes.push(name.trim());
 save();
}

function changeQty(customerId,crateName,direction){
 const c=data.customers.find(x=>x.id===customerId);
 if(!c)return;
 const qty=Number(prompt("કેટલા ક્રેટનો હિસાબ કરવો છે?","1"));
 if(!Number.isFinite(qty)||qty<=0)return;
 data.transactions.push({
  id:id(),
  customerId:customerId,
  crateName:crateName,
  type:direction,
  qty:qty,
  date:new Date().toISOString()
 });
 save();
}

function balance(customerId,crateName){
 return data.transactions
 .filter(x=>x.customerId===customerId&&x.crateName===crateName)
 .reduce((sum,x)=>sum+(x.type==="IN"?Number(x.qty):-Number(x.qty)),0);
}

function renameCustomer(customerId){
 const c=data.customers.find(x=>x.id===customerId);
 if(!c)return;
 const name=prompt("નવું નામ લખો:",c.name);
 if(name&&name.trim()){
  c.name=name.trim();
  save();
 }
}

function archiveCustomer(customerId){
 const c=data.customers.find(x=>x.id===customerId);
 if(!c)return;
 if(!confirm("આ ગ્રાહકને આર્કાઇવ કરવો છે? તેનો હિસાબ ડિલીટ નહીં થાય."))return;
 c.archived=!c.archived;
 save();
}

function escapeHtml(s){
 return String(s).replace(/[&<>"']/g,c=>({
  "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
 }[c]));
}

function showLedger(customerId){
 selectedCustomer=customerId;
 const c=data.customers.find(x=>x.id===customerId);
 if(!c)return;
 const rows=data.transactions
 .filter(x=>x.customerId===customerId)
 .sort((a,b)=>new Date(b.date)-new Date(a.date));

 document.getElementById("ledger").innerHTML=
 "<h3>"+escapeHtml(c.name)+"</h3>"+
 (rows.length?rows.map(x=>
 `<div class="crate">
 <strong>${escapeHtml(x.crateName)}</strong>
 <span>${x.type==="IN"?"જમા +":"ઉધાર −"} ${x.qty}</span>
 <span class="small">${new Date(x.date).toLocaleString("gu-IN")}</span>
 </div>`).join(""):"હજુ કોઈ વ્યવહાર નથી.");
}

function render(){
 const list=document.getElementById("customerList");

 if(!data.customers.length){
  list.innerHTML="હજુ કોઈ ગ્રાહક ઉમેર્યો નથી.";
 }else{
  list.innerHTML=data.customers.map(c=>{
   c.crateTypes=c.crateTypes||[];

   return `<div class="person">
    <h3>${escapeHtml(c.name)}</h3>
    <div class="actions">
     <button onclick="addCrate('${c.id}')">+ ક્રેટનું નામ</button>
     <button class="gray" onclick="renameCustomer('${c.id}')">નામ બદલો</button>
     <button class="orange" onclick="archiveCustomer('${c.id}')">${c.archived?"ફરી ચાલુ કરો":"આર્કાઇવ"}</button>
     <button class="gray" onclick="showLedger('${c.id}')">હિસાબ જુઓ</button>
    </div>
    ${c.archived?'<p class="small">આર્કાઇવ થયેલ ગ્રાહક</p>':
    (c.crateTypes.length?c.crateTypes.map(name=>{
     const q=balance(c.id,name);
     return `<div class="crate">
      <strong>${escapeHtml(name)}</strong>
      <span class="qty">${q}</span>
      <button onclick="changeQty('${c.id}',${JSON.stringify(name)},'IN')">+ જમા</button>
      <button class="red" onclick="changeQty('${c.id}',${JSON.stringify(name)},'OUT')">− ઉધાર</button>
     </div>`;
    }).join(""):'<p class="small">હજુ ક્રેટ ઉમેર્યા નથી.</p>')}
   </div>`;
  }).join("");
 }

 if(selectedCustomer)showLedger(selectedCustomer);
}

function backup(){
 const blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"});
 const a=document.createElement("a");
 a.href=URL.createObjectURL(blob);
 a.download="KH-Fruits-Customer-Backup.json";
 a.click();
 URL.revokeObjectURL(a.href);
}

function restore(){
 const file=document.getElementById("restoreFile").files[0];
 if(!file)return alert("પહેલા બેકઅપ ફાઇલ પસંદ કરો.");
 if(!confirm("હાલનો ગ્રાહક ડેટા બદલાઈ શકે છે. પહેલાં બેકઅપ રાખ્યો છે?"))return;

 const reader=new FileReader();
 reader.onload=()=>{
  try{
   const d=JSON.parse(reader.result);
   if(!Array.isArray(d.customers)||!Array.isArray(d.transactions))
    throw new Error();
   data=d;
   save();
   alert("બેકઅપ રિસ્ટોર થયો.");
  }catch(e){
   alert("બેકઅપ ફાઇલ યોગ્ય નથી.");
  }
 };
 reader.readAsText(file);
}

render();
</script>
</body>
</html>